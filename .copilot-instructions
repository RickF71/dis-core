-- Phase 9D: receipts_status_view for continuity dashboard
CREATE OR REPLACE VIEW receipts_status_view AS
SELECT
  r.id,
  r.receipt_type,
  r.event_id,
  (r.policy_ref IS NOT NULL)  AS policy_linked,
  (r.redaction_ref IS NOT NULL) AS redacted,
  (o.receipt_id IS NOT NULL) AS orphaned
FROM receipts r
LEFT JOIN receipts_orphan_view o ON r.id = o.receipt_id;

COMMENT ON VIEW receipts_status_view IS
'Phase 9D continuity dashboard: summarizes linkage and orphan status for receipts.';

