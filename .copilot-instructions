package bootstrap

import (
	"context"
	"fmt"
	"log"

	"github.com/jackc/pgx/v5/pgxpool"
)

func performPhase9DCheck(db *pgxpool.Pool) error {
	ctx := context.Background()
	row := db.QueryRow(ctx, `
		SELECT COUNT(*),
		       COUNT(*) FILTER (WHERE orphaned)
		FROM receipts_status_view;
	`)
	var total, orphaned int
	if err := row.Scan(&total, &orphaned); err != nil {
		return err
	}
	log.Printf("[phase_9d] receipts total=%d orphaned=%d", total, orphaned)
	appendPhaseLog("phase_9d.log",
		fmt.Sprintf("Phase 9D: %d total, %d orphaned", total, orphaned))
	return nil
}

