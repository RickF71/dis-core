package api

import (
	"context"
	"encoding/json"
	"net/http"
	"strconv"

	"dis-core/internal/model"
)

func (s *Server) handleListReceipts(w http.ResponseWriter, r *http.Request) {
	ctx := context.Background()
	q := r.URL.Query()
	limit, _ := strconv.Atoi(q.Get("limit"))
	offset, _ := strconv.Atoi(q.Get("offset"))
	orphanOnly := q.Get("orphaned") == "true"
	if limit <= 0 { limit = 50 }

	query := `
	SELECT id, receipt_type, event_id, policy_linked, redacted, orphaned
	FROM receipts_status_view`
	if orphanOnly {
		query += " WHERE orphaned = true"
	}
	query += " ORDER BY id LIMIT $1 OFFSET $2"

	rows, err := s.db.Query(ctx, query, limit, offset)
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}
	defer rows.Close()

	type Response struct {
		Receipts []model.ReceiptSummary `json:"receipts"`
		Page     int                    `json:"page"`
		Limit    int                    `json:"limit"`
	}
	var result Response
	for rows.Next() {
		var rec model.ReceiptSummary
		if err := rows.Scan(&rec.ID, &rec.Type, &rec.EventID, &rec.PolicyLinked, &rec.Redacted, &rec.Orphaned); err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		result.Receipts = append(result.Receipts, rec)
	}
	result.Page = offset/limit + 1
	result.Limit = limit

	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(result)
}

