  "rego_policy_hooks": {
    "description": "Future REGO policy enforcement patterns",
    "AUTO": {
      "policy": "Treat as structural edges, not user-selectable personas",
      "authority": "Flows through seat, not alias directly",
      "use_case": "Lineage/provenance queries"
    },
    "RELATIONSHIP": {
      "policy": "Grant domain-specific capabilities based on alias scope",
      "authority": "Must reference DSCI contract",
      "revocation": "Can be revoked if contract is terminated"
    },
    "MASK": {
      "policy": "Default: DENY ALL privileged operations",
      "allowed": [
        "Read-only discovery",
        "Public content access",
        "Explicitly whitelisted low-risk actions"
      ],
      "denied": [
        "Write operations",
        "Admin actions",
        "Grant/revoke authority",
        "Persistent state changes"
      ],
      "requirement": "Explicit DSCI authorization for any privileged action"
    }
  },

