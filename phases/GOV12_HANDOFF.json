      ]
    },
    "repository_layer": {
      "file": "internal/repo/alias_repo.go",
      "lines": 292,
      "struct": "AliasRepository",
      "methods": [
        "CreateAlias(ctx, *Alias) error",
        "RetireAlias(ctx, id, reason) error",
        "GetAliasesForOwner(ctx, ownerID, includeRetired) ([]Alias, error)",
        "GetAliasesForTarget(ctx, targetID, includeRetired) ([]Alias, error)",
        "GetAliasesByType(ctx, ownerID, type, includeRetired) ([]Alias, error)",
        "GetActiveMaskAliasesForOwner(ctx, ownerID) ([]Alias, error)",
        "GetCorporealAutoAlias(ctx, ownerID) (*Alias, error)",
        "GetAliasByID(ctx, id) (*Alias, error)",
        "FindActiveAliasByName(ctx, owner, target, name) (*Alias, error)"
      ],
      "helpers": [
        "GenerateMaskName() string - generates 'mask-<8hex>'"
      ]
    },
    "service_layer": {
      "file": "internal/services/alias_service.go",
      "lines": 208,
      "struct": "AliasService",
      "methods": [
        {
          "name": "EnsureCorporealRootAlias",
          "signature": "(ctx, corporealDomainID) (*Alias, error)",
          "description": "Idempotent AUTO alias for corporeal domains",
          "semantics": [
            "Checks existing via GetCorporealAutoAlias()",
            "Creates self-referential alias (owner=target)",
            "Sets is_corporeal_auto=true",
            "Returns existing if present"
          ]
        },
        {
          "name": "EnsureStructuralAlias",
          "signature": "(ctx, ownerID, targetID) (*Alias, error)",
          "description": "AUTO alias for structural membership",
          "semantics": [
            "Non-corporeal AUTO aliases",
            "Used during seat instantiation",
            "Owner=person's domain, Target=membership domain",
            "Idempotent"
          ]
        },
        {
          "name": "CreateRelationshipAlias",
          "signature": "(ctx, ownerID, targetID, name, contractID, metadata) (*Alias, error)",
          "description": "Volitional domain-scoped identity",
          "semantics": [
            "Requires alias_name (user-chosen)",
            "Checks conflicts via FindActiveAliasByName()",
            "Links dsci_contract_id if provided",
            "Owner and target specify scope"
          ]
        },
        {
          "name": "CreateMaskAlias",
          "signature": "(ctx, ownerID, requestedName, ttlDays, metadata) (*Alias, error)",
          "description": "Ephemeral browsing persona",
          "semantics": [
            "Auto-generates name if empty (via GenerateMaskName())",
            "Self-targeting: owner=target=ownerDomainID",
            "Optional TTL in metadata",
            "Minimal authority by design"
          ]
        },
        {
          "name": "RetireAlias",
          "signature": "(ctx, id, reason) error",
          "description": "Marks alias as retired with reason"
        },
        {
          "name": "GetAliasesForDomain",
          "signature": "(ctx, domainID, includeRetired) ([]Alias, error)",
          "description": "Merges owner + target aliases, deduplicates"
        }
      ]
    }
  },

  "api_endpoints": {
